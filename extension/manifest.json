{
  "manifest_version": 3,
  "name": "Browser MCP Companion",
  "short_name": "Browser MCP",
  "version": "0.1.0",
  "description": "Open-source browser extension for the Browser MCP server: lets AI apps automate the tab you connect.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser MCP",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
