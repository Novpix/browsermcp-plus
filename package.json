{
  "name": "browsermcp-plus",
  "version": "0.5.0",
  "description": "MCP server + open-source Chrome extension that let AI apps automate your own browser: clicks, typing, file uploads, tabs, JavaScript",
  "author": "Novpix",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Novpix/browsermcp-plus#readme",
  "bugs": "https://github.com/Novpix/browsermcp-plus/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novpix/browsermcp-plus.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "chrome-extension",
    "claude",
    "cursor",
    "ai-agent",
    "file-upload"
  ],
  "type": "module",
  "bin": {
    "browsermcp-plus": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:real": "npm run build && REAL_CHROME=1 vitest run --config vitest.e2e.config.ts test/e2e/real-chrome.e2e.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^13.1.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "1.63",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
