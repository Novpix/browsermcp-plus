{
  "manifest_version": 3,
  "name": "Browser MCP Plus",
  "short_name": "MCP Plus",
  "version": "0.4.0",
  "description": "Let AI apps (Claude, Cursor, VS Code\u2026) automate the browser tab you connect: clicks, typing, file uploads, tabs and more.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser MCP Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://github.com/Novpix/browsermcp-plus"
}
